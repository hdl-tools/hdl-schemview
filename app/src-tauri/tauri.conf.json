{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hdl-schemview",
  "version": "0.1.0",
  "identifier": "dev.hdlschemview.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hdl-schemview",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "hdl-schemview",
    "category": "DeveloperTool",
    "shortDescription": "RTL-level SystemVerilog cross-probe tool",
    "longDescription": "Links source, schematic and waveform views of an elaborated SystemVerilog design and keeps them in sync: click a signal in any one view and the others jump to the matching object.",
    "copyright": "MIT licensed",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
